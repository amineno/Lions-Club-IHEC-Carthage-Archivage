# ===== BASE DE DONNÉES POSTGRESQL =====
# Supabase / Neon / Railway
DATABASE_URL="postgresql://user:password@host:5432/lions_club_archive?schema=public"

# ===== AUTHENTIFICATION (NextAuth v5) =====
NEXTAUTH_SECRET="une-chaine-aleatoire-tres-longue-avec-des-chiffres-et-symboles"
NEXTAUTH_URL="http://localhost:3000"

# ===== SUPABASE (Storage + Auth optionnel) =====
# Utlisé pour le stockage des fichiers uploadés (PDF, DOC, Images...)
NEXT_PUBLIC_SUPABASE_URL="https://votre-projet.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="votre-cle-anon-supabase"
SUPABASE_SERVICE_ROLE_KEY="votre-cle-service-role-supabase"

# Nom du bucket Supabase Storage (à créer dans le dashboard Supabase)
SUPABASE_BUCKET_NAME="lions-club-archives"
